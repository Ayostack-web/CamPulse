# ─── Server ──────────────────────────────────────────────
PORT=4000
MAX_UPLOAD_MB=50

# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vylix"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vylix"

# ─── Redis ───────────────────────────────────────────────
# Rate-limiting & caching. Keep isolated from Celery Redis to prevent
# result-backend TTLs from evicting rate-limit keys under memory pressure.
REDIS_URL="redis://localhost:6379/0"

# ─── Storage Provider ────────────────────────────────────
# Choose between "supabase" (default) or "appwrite"
STORAGE_PROVIDER=supabase

# ─── Supabase Storage ────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="materials"
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_JWT_SECRET=""

# ─── Appwrite Storage ────────────────────────────────────
# APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
# APPWRITE_PROJECT_ID=""
# APPWRITE_API_KEY=""
# APPWRITE_STORAGE_BUCKET_ID=""

# ─── AI ──────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Vector Search ───────────────────────────────────────
# "auto" uses pgvector when GEMINI_API_KEY is set, otherwise ChromaDB.
# Force one backend with "pgvector" or "chromadb".
VECTOR_STORE_BACKEND=auto
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CACHE_TTL_SECONDS=604800

# ─── Google Drive ────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# This is where Google redirects after user authorizes — must match Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/google-drive/callback"
# Where to send the user after Drive connection is complete
FRONTEND_URL="http://localhost:3000"

# ─── Paystack ────────────────────────────────────────────
# Sign up at https://paystack.com and get keys from your dashboard
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_API_KEY=""

# NOTE: Do NOT commit secrets. Rename this file to `.env` locally and fill with
# real secrets when running locally or in CI.
