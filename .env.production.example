# ─── Database (Supabase) ─────────────────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL="https://ntxcmqouahvqylmgoyjp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="materials"
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_JWT_SECRET=""

# ─── AI ──────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Google Drive ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://api.vylix.app/api/google-drive/callback"
FRONTEND_URL="https://vylix.vercel.app"

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_API_KEY=""

# ─── CORS ────────────────────────────────────────────────
# The API refuses to start without this (main.py exits FATAL if unset).
# Web (Vercel) domain goes here; CORS also auto-allows any *.vercel.app.
CORS_ORIGINS="https://vylix.vercel.app,http://localhost:3000"

# ─── Paystack ────────────────────────────────────────────
# Get from https://dashboard.paystack.com -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_live_..."
PAYSTACK_PUBLIC_KEY="pk_live_..."
# Paystack Dashboard -> Webhooks -> set to your API URL
# PAYSTACK_WEBHOOK_URL="https://api.vylix.app/api/v1/payments/webhook"

# ─── Celery / Redis ──────────────────────────────────────
# Redis serves as cache (DB 0), Celery result backend (DB 1) and Celery
# broker (DB 2). docker-compose.prod.yml injects:
#   REDIS_URL=redis://redis:6379/0
#   CELERY_RESULT_BACKEND=redis://redis:6379/1
#   CELERY_BROKER_URL=redis://redis:6379/2

# NOTE: Fill in the blank values above before deploying.
# Get Supabase connection strings from: Dashboard > Settings > Database > Connection string > URI
